# 아래 값들은 Vercel 프로젝트 설정 > Environment Variables 에 그대로 등록하세요.
# (이 파일 자체는 예시일 뿐이라 실제 값을 적어도 안전하지 않으니 비워둡니다.)

# Supabase 대시보드 > Project Settings > API > service_role 키
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter(openrouter.ai) 발급 API 키
OPENROUTER_API_KEY=

# 아무 문자열이나 직접 정해서 넣는 비밀번호 같은 값 (외부에서 수집 API를 함부로 못 부르게 막는 용도)
CRON_SECRET=

# 선택: 번역에 쓸 OpenRouter 모델을 바꾸고 싶을 때만 설정 (기본값: google/gemini-2.5-flash-lite)
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
